# NetworkManager keyfile for the Pi's Wi-Fi. The real file holds the PSK and is
# never committed. Install it as root, mode 600:
#   /etc/NetworkManager/system-connections/wifi.nmconnection
# then: nmcli con reload && nmcli con up wifi
[connection]
id=wifi
type=wifi
autoconnect=true
autoconnect-priority=10

[wifi]
mode=infrastructure
ssid=wifi
# Keep the real MAC so a DHCP reservation on your router keeps matching.
cloned-mac-address=permanent
# 2 = power save off. Pi 3B Wi-Fi power save causes dropouts.
powersave=2

[wifi-security]
key-mgmt=wpa-psk
psk=YOUR_WIFI_PASSWORD

[ipv4]
method=auto

[ipv6]
method=auto
