[Unit]
Description=PixelPane LED matrix controller (scenes, GIFs, web UI on :80)
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
# Starts as root to open the GPIO and port 80, then drops to the pixelpane user.
User=root
WorkingDirectory=/opt/pixelpane
Environment=PYTHONPATH=/opt/pixelpane PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
Environment=PIXELPANE_CACHE=/var/lib/pixelpane/cache
ExecStart=/opt/pixelpane/venv/bin/python -m pixelpane.app
Restart=always
RestartSec=3
# Sandboxing. The panel driver needs /dev/mem or /dev/gpiomem (or /dev/pio0 on a Pi 5)
# and real-time scheduling, so devices and realtime stay allowed.
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/pixelpane
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
